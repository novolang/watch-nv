// wtinotify.nv — the Linux backend, and the four limits an operator
// meets.
//
// `[io]` AND NOT `[fs]`.  An inotify watcher is a file descriptor: the
// instance comes from `inotify_init1`, a watch from `inotify_add_watch`,
// and events from `read` on the descriptor.  Nothing here opens a file
// or reads a directory — placing a watch does not stat the path's
// contents, and the events arrive on a descriptor.  So the honest row is
// `[io]`, which SPEC § 5.1 puts pipes, processes and descriptors under,
// and the polling backend beside it is the one that is `[fs]`.
//
// THE FOUR LIMITS, because every one of them is a support question:
//
//   - `fs.inotify.max_user_watches` — the total watches one user may
//     hold, 8192 on a stock kernel and routinely raised to 524288.  A
//     recursive watch over a repository with a build directory nobody
//     excluded hits it, which is why `wtfilter.may_descend` decides
//     before a watch is placed rather than after.
//   - `fs.inotify.max_user_instances` — how many watchers one user may
//     have, 128.  Reached by a tool that opens one per project and
//     never closes them.
//   - `fs.inotify.max_queued_events` — 16384, and when the queue fills
//     the kernel DROPS events and sends `IN_Q_OVERFLOW`.  The only
//     correct response is a full rescan.
//   - the read buffer.  An event's name is variable-length, so a read
//     with a buffer smaller than one event answers `EINVAL` and a
//     watcher with a fixed small buffer stops working on deep paths.
//
// `limits_from_proc` reads the first three, so a tool can print them
// beside its own watch count when a person asks why it stopped noticing
// changes.
//
// WHAT THIS BACKEND CANNOT DO, named rather than discovered.  It does
// not see changes on a network filesystem, because the kernel is not
// told about them; it does not see changes made through a bind mount to
// the same file under another path; and it reports a rename's two halves
// separately, which `wtevent.pair` puts back together.

use wtevent
use wtwatch

// An inotify instance.
//
// The descriptor and the read buffer size, which is a field because the
// right value depends on the tree: a buffer under 4 KB fails on deep
// paths and one of 64 KB costs nothing on a machine that has memory.
pub struct WtInotify
    fd: Int
    buffer_bytes: Int
    // Whether the descriptor was opened non-blocking.  `poll` honours
    // its deadline either way.
    non_blocking: Bool

// The C boundary, as five private shims.
//
// Nothing in the standard library makes a watch, so this backend reaches
// the kernel through libc, which every program already links.  Each shim
// declares `[ffi]`, because a body-less declaration is the whole
// contract, and each call site below discharges it — which is what keeps
// the public rows at the `[io]` this module's header argues for.
@ffi(library = "c", symbol = "inotify_init1")
fn c_inotify_init1(flags: i32) -> i32 [io, ffi]

@ffi(library = "c", symbol = "inotify_add_watch")
fn c_inotify_add_watch(fd: i32, file_path: Str, mask: u32) -> i32 [io, ffi]

@ffi(library = "c", symbol = "inotify_rm_watch")
fn c_inotify_rm_watch(fd: i32, wd: i32) -> i32 [io, ffi]

@ffi(library = "c", symbol = "close")
fn c_close(fd: i32) -> i32 [io, ffi]

@ffi(library = "c", symbol = "__errno_location")
fn c_errno_location() -> Int [io, ffi]

// The `errno` values the calls above set, by the number Linux gives
// them.
//
// The errno names are upper-case constants because a constant named in
// a match pattern binds rather than compares when its name is lowercase:
// the mappings below are `match` expressions on them.
const E_PERM = 1
const E_NOENT = 2
const E_INTR = 4
const E_BADF = 9
const E_AGAIN = 11
const E_ACCES = 13
const E_INVAL = 22
const E_FILE = 23
const E_MFILE = 24
const E_NOSPC = 28
const E_NOSYS = 38
const E_NOTSUP = 95

// The two flags an instance is opened with.
//
// These are the `O_*` flags `inotify_init1` takes, not the `IN_*` mask
// bits below, one of which happens to sit on the same bit: non-blocking,
// so a read never waits past the deadline, and close-on-exec, so a child
// process does not inherit the descriptor.
let o_nonblock = 1 << 11
let o_cloexec  = 1 << 19

// The mask bits a watch is placed with, by position as the kernel numbers
// them.
let in_modify         = 1 << 1
let in_attrib         = 1 << 2
let in_moved_from     = 1 << 6
let in_moved_to       = 1 << 7
let in_create         = 1 << 8
let in_delete         = 1 << 9
let in_delete_self    = 1 << 10
let in_move_self      = 1 << 11
let in_unmount        = 1 << 13
let in_queue_overflow = 1 << 14
let in_ignored        = 1 << 15
let in_onlydir        = 1 << 24
let in_excl_unlink    = 1 << 26
let in_isdir          = 1 << 30

// The buffer an instance is opened with by default: 64 KB, which holds
// some two thousand events at the deepest path a repository has.
let default_buffer_bytes = 65536

// The errno the last failed call left.
//
// Read through the libc accessor rather than through a saved copy,
// because the value is per thread and the call that set it is the one
// just made — `io.read_fd` between a failed call and this one would
// clobber an arm that let anything run.
fn errno_now() -> Int [io]
    var e = 0
    unsafe_discharge [ffi]
        e = ptr.read_i32(c_errno_location())
    e

// The flags `inotify_init1` is called with.
fn open_flags() -> Int
    o_nonblock | o_cloexec

// The mask every watch is placed with.
//
// Create, delete, modify, attrib and both halves of a move; the two self
// events, so a watch that died is reported rather than silently gone;
// and the two flags that make the watch honest — `IN_ONLYDIR`, so a path
// that is a file is refused instead of watched uselessly, and
// `IN_EXCL_UNLINK`, so the events for an unlinked file stop.
fn watch_mask() -> Int
    var mask = in_create | in_delete | in_modify | in_attrib
    mask = mask | in_moved_from | in_moved_to
    mask = mask | in_delete_self | in_move_self
    mask | in_onlydir | in_excl_unlink

// A record's watch id, or zero for the one descriptor that is not a
// watch.
//
// The kernel reports a queue overflow with a descriptor of -1, which is
// read here as its unsigned 32-bit self; a watch id is how a caller
// looks its watch up, and an overflow has none to look up.
fn watch_id_of(wd: Int) -> Int
    if wd > 2147483647
        0
    else
        wd

// Why a watch could not be placed, from the errno the kernel left.
//
// Every arm is a different conversation with an operator: a missing
// path, a permission, the watch limit, the instance limit and a
// filesystem that will not signal are five different remedies, which is
// what the fault type exists to keep apart.  The two limits carry `0`
// for the number, the same way a dropped-event count does, because the
// kernel states the limit in `/proc` and not in the error.
fn watch_fault(file_path: Str, e: Int) -> WtFault
    match e
        E_NOENT            => WtNotFound(file_path)
        E_ACCES | E_PERM   => WtPermissionDenied(file_path)
        E_NOSPC            => WtWatchLimit(0)
        E_MFILE | E_FILE   => WtInstanceLimit(0)
        E_NOSYS | E_NOTSUP => WtUnsupportedFilesystem(file_path)
        E_INVAL            => WtBackendFailed("the path is not a directory: " + file_path)
        E_BADF             => WtClosed
        _                  => WtBackendFailed("inotify_add_watch failed with errno " + str.from_int(e))

// Why an instance could not be opened, from the errno the kernel left.
//
// The instance limit is the one fault a kernel reports here that has a
// remedy, and the only one whose remedy is not the polling backend.
fn instance_fault(e: Int) -> WtFault
    match e
        E_MFILE | E_FILE   => WtInstanceLimit(0)
        E_NOSYS | E_NOTSUP => WtUnsupportedFilesystem("inotify")
        _                  => WtBackendFailed("inotify_init1 failed with errno " + str.from_int(e))

// One little-endian 32-bit field of an event record.
//
// The four header words are written in the host's byte order, which on
// every machine this backend builds for is little-endian.
fn u32_at(b: Bytes, at: Int) -> Int
    let b0 = bytes.byte_at(b, at) ?? 0
    let b1 = bytes.byte_at(b, at + 1) ?? 0
    let b2 = bytes.byte_at(b, at + 2) ?? 0
    let b3 = bytes.byte_at(b, at + 3) ?? 0
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

// The name a record carries.
//
// A name is relative to the watched directory, and it sits in a field
// the kernel pads with NULs to the record's alignment — with the padding
// counted in the field's length, so the name ends at the first zero
// byte.  Scanning for that byte is what `bytes.to_str` does not do: a
// `Str` holds the bytes it was given, NULs and all, so the padding has
// to be left off before the name becomes a path.  The field's end is
// clamped to the buffer so that a short read answers a short name rather
// than a panic.
fn name_at(b: Bytes, at: Int, len: Int) -> Str
    let hi = at + len
    let total = bytes.len(b)
    let end = if hi < total
        hi
    else
        total
    var stop = at
    while stop < end and (bytes.byte_at(b, stop) ?? 0) != 0
        stop = stop + 1
    if stop <= at
        ""
    else
        bytes.to_str(bytes.slice(b, at, stop))

// One record as a raw event, or nothing when the mask carries no kind a
// consumer of this package has a name for.
//
// The self events are reported as a lost watch rather than as a change
// to a path: a consumer that read the watched directory's own removal as
// one more removal would keep a watch that no longer exists.  A rename's
// two halves carry the kernel's cookie, which is what pairs them.
fn raw_of(wd: Int, mask: Int, cookie: Int, name: Str) -> ?WtRawEvent
    let is_directory = (mask & in_isdir) != 0
    let id = watch_id_of(wd)
    match mask
        _ if (mask & in_queue_overflow) != 0                                         => Some(wtevent.raw(WtRawOverflow, "", false, 0, 0))
        _ if (mask & (in_unmount | in_ignored | in_delete_self | in_move_self)) != 0 =>
            Some(wtevent.raw(WtRawWatchLost, "", true, 0, id))
        _ if (mask & in_create) != 0                                                 => Some(wtevent.raw(WtRawCreated, name, is_directory, 0, id))
        _ if (mask & in_delete) != 0                                                 => Some(wtevent.raw(WtRawRemoved, name, is_directory, 0, id))
        _ if (mask & in_moved_from) != 0                                             =>
            Some(wtevent.raw(WtRawMovedFrom, name, is_directory, cookie, id))
        _ if (mask & in_moved_to) != 0                                               =>
            Some(wtevent.raw(WtRawMovedTo, name, is_directory, cookie, id))
        _ if (mask & in_modify) != 0                                                 => Some(wtevent.raw(WtRawModified, name, is_directory, 0, id))
        _ if (mask & in_attrib) != 0                                                 => Some(wtevent.raw(WtRawMetadata, name, is_directory, 0, id))
        _                                                                            => None

// The raw events in one read buffer, and whether the kernel dropped any.
//
// Each record is four 32-bit words — the watch, the mask, the move
// cookie and the name's length — followed by the name padded to the next
// 16-byte boundary, which is what makes the stride `16 + len`.  A record
// longer than what is left in the buffer is dropped rather than read
// past: the kernel answers whole records, so a partial one is a buffer
// that was already misread.
fn raw_events(buf: Bytes) -> ([WtRawEvent], Bool)
    var out: [WtRawEvent] = []
    var dropped = false
    var at = 0
    let total = bytes.len(buf)
    while at + 16 <= total
        let wd = u32_at(buf, at)
        let mask = u32_at(buf, at + 4)
        let cookie = u32_at(buf, at + 8)
        let len = u32_at(buf, at + 12)
        match raw_of(wd, mask, cookie, name_at(buf, at + 16, len))
            Some(e) =>
                if e.kind == WtRawOverflow
                    dropped = true
                out = list.push(out, e)
            None    =>
                0
        at = at + 16 + len
    (out, dropped)

// One read's answer.
//
// A buffer read to its last byte may have more behind it, so `timed_out`
// is false and the caller calls again before it sleeps; anything shorter
// is everything the kernel had.
fn poll_of(buf: Bytes, buffer_bytes: Int) -> WtPoll
    let (events, dropped) = raw_events(buf)
    WtPoll { events: events, timed_out: bytes.len(buf) < buffer_bytes,
             overflowed: dropped }

// The wait's deadline in the milliseconds `io.wait_either` takes.
//
// A deadline below zero is a caller that wants what is queued and
// nothing more, which is a zero timeout rather than an error.
fn wait_ms(timeout_seconds: Float) -> Int
    let ms = float.to_int(timeout_seconds * 1000.0)
    if ms < 0
        0
    else
        ms

// The answer to a read that failed, from the errno it left.
//
// `EAGAIN` is not a fault: the descriptor is non-blocking and the queue
// is empty, which is an idle poll.  An interrupted read is the same
// answer for the same reason — the next turn is a fresh attempt.  A
// descriptor that is gone is the backend having been closed, which has
// its own arm rather than a failure a caller has to decode.
// cov: skip — a read that fails after the readiness call said ready leaks one object in the runtime, so no suite may take this path
fn failed_read() -> Result<WtPoll, WtFault> [io]
    let e = errno_now()
    match e
        E_AGAIN | E_INTR => Ok(WtPoll { events: [], timed_out: true, overflowed: false })
        E_BADF           => Err(WtClosed)
        _                => Err(WtBackendFailed("read failed with errno " + str.from_int(e)))

// One number out of `/proc/sys`, where the limits sit as decimal text
// with a trailing newline.
fn proc_number(file_path: Str) -> Result<Int, WtFault> [fs]
    match fs.read(file_path)
        Some(text) =>
            match str.to_int(str.trim(text))
                Some(n) =>
                    Ok(n)
                None    =>
                    Err(WtBackendFailed("not a number in " + file_path))
        None       =>
            Err(WtBackendFailed("could not read " + file_path))

// Reading a descriptor costs `[io]`, which is what the impl head
// declares and the effect checker holds every method to.
impl WatchBackend[io] for WtInotify
    // `inotify_add_watch` on this directory.
    //
    // The mask is fixed and is not a parameter: create, delete, modify,
    // attrib, moved-from, moved-to, delete-self, move-self, plus
    // `IN_ONLYDIR` so a path that is a file is refused rather than
    // watched uselessly and `IN_EXCL_UNLINK` so events for an unlinked
    // file stop.  A caller that wanted fewer filters with `WtFilter`,
    // which is testable; a mask parameter would put a bitfield in a
    // public surface and give four callers four subtly different
    // watchers.
    fn watch(self, path: Str) -> Result<Int, WtFault> [io]
        var wd = 0
        unsafe_discharge [ffi]
            wd = c_inotify_add_watch(self.fd as i32, path, watch_mask() as u32)
        if wd < 0
            Err(watch_fault(path, errno_now()))
        else
            Ok(wd)

    // `inotify_rm_watch`.  A watch the kernel already removed — because
    // the directory went away — is not a failure.
    fn unwatch(self, id: Int) -> Result<Unit, WtFault> [io]
        var rc = 0
        unsafe_discharge [ffi]
            rc = c_inotify_rm_watch(self.fd as i32, id as i32)
        if rc == 0
            return Ok(())
        let e = errno_now()
        if e == E_INVAL
            // The kernel had already removed it, which is the race this
            // method's contract says not to make a caller care about.
            return Ok(())
        if e == E_BADF
            return Err(WtClosed)
        // cov: skip — rm_watch answers EINVAL or EBADF, both answered above, and any other errno is not a state a suite can arrange
        Err(WtBackendFailed("inotify_rm_watch failed with errno " + str.from_int(e)))

    // Read whatever is queued, waiting at most this long.
    //
    // One read per call, so a caller that is handed a full buffer calls
    // again — which `WtPoll.timed_out` being `false` says.
    fn poll(self, timeout_seconds: Float) -> Result<WtPoll, WtFault> [io]
        // The deadline is answered by the readiness call rather than by
        // a read that finds nothing: an idle queue is not an error, and
        // a failed read at this boundary leaks one object in the
        // runtime, so the read happens only when the kernel has said
        // there is something to read.  A descriptor that is ready
        // answers the call at once, so nothing waits that need not.
        let ready = io.wait_either(self.fd, -1, wait_ms(timeout_seconds))
        if ready == 0
            return Ok(WtPoll { events: [], timed_out: true, overflowed: false })
        match io.read_fd(self.fd, self.buffer_bytes)
            Some(buf) =>
                Ok(poll_of(buf, self.buffer_bytes))
            None      =>
                // cov: skip — this answer is reached only when a read that the kernel called ready fails, and a failing read leaks one object
                failed_read()

    // Close the descriptor, which releases every watch on it.
    fn close(self) -> Result<Unit, WtFault> [io]
        var rc = 0
        unsafe_discharge [ffi]
            rc = c_close(self.fd as i32)
        if rc == 0
            return Ok(())
        let e = errno_now()
        if e == E_BADF
            return Err(WtClosed)
        // cov: skip — close(2) on a descriptor this process still holds fails only if the kernel itself is broken
        Err(WtBackendFailed("close failed with errno " + str.from_int(e)))

// The three kernel limits, as they are now.
pub struct WtInotifyLimits
    max_user_watches: Int
    max_user_instances: Int
    max_queued_events: Int

// Open an inotify instance with a 64 KB buffer.
//
// ```novo
// use wtinotify
//
// fn start() -> Result<WtInotify, WtFault> [io]
//     wtinotify.open()
//
// fn main() [io]
//     println("an inotify watcher")
// ```
pub fn open() -> Result<WtInotify, WtFault> [io]
    open_with(default_buffer_bytes)

// Open one with a buffer the caller sized.
//
// Under 4096 is refused rather than accepted and then failing on the
// first deep path, because `EINVAL` from a read with a short buffer is
// the least explicable error in this whole surface.
//
// ```novo
// use wtinotify
//
// fn start() -> Result<WtInotify, WtFault> [io]
//     wtinotify.open_with(65536)
//
// fn main() [io]
//     println("an inotify watcher with a chosen buffer")
// ```
pub fn open_with(buffer_bytes: Int) -> Result<WtInotify, WtFault> [io]
    if buffer_bytes < 4096
        return Err(WtBackendFailed("a read buffer under 4096 bytes answers EINVAL on a deep path"))
    var fd = 0
    unsafe_discharge [ffi]
        fd = c_inotify_init1(open_flags() as i32)
    if fd < 0
        // cov: skip — inotify_init1 is refused only when the process is out of descriptors or instances, which a suite on a shared machine must not force
        Err(instance_fault(errno_now()))
    else
        Ok(WtInotify { fd: fd, buffer_bytes: buffer_bytes, non_blocking: true })

// Is this kernel one this backend works on?
//
// `[io]`, because it looks.  A tool calls it once at startup and falls
// back to `wtpoll` when it answers `false`, rather than discovering the
// answer from a watch that never fires.
//
// ```novo
// use wtinotify
//
// fn here() -> Bool [io]
//     wtinotify.is_available()
//
// fn main() [io]
//     println("whether inotify is here")
// ```
pub fn is_available() -> Bool [io]
    match open()
        Ok(w)  =>
            let _ = w.close()
            true
        Err(_) =>
            // cov: skip — a kernel without inotify is not a machine the suites run on
            false

// The three limits, read from `/proc/sys/fs/inotify`.
//
// `[fs]`, and it is the one row in this module that is not `[io]` —
// because it genuinely reads three files, and a row that claimed
// otherwise would be a lie the checker cannot catch.
//
// What it is for: a tool that hits `WtWatchLimit` can print "8192
// watches is the limit and I placed 8192" instead of "too many watches",
// which is the difference between an operator raising a `sysctl` and an
// operator filing an issue.
//
// ```novo
// use wtinotify
//
// fn limits() -> Result<WtInotifyLimits, WtFault> [fs]
//     wtinotify.limits_from_proc()
//
// fn main() [io]
//     println("what this kernel allows")
// ```
pub fn limits_from_proc() -> Result<WtInotifyLimits, WtFault> [fs]
    let watches = proc_number("/proc/sys/fs/inotify/max_user_watches")!
    let instances = proc_number("/proc/sys/fs/inotify/max_user_instances")!
    let queued = proc_number("/proc/sys/fs/inotify/max_queued_events")!
    Ok(WtInotifyLimits { max_user_watches: watches, max_user_instances: instances,
                         max_queued_events: queued })

// The stock defaults, for a machine whose `/proc` could not be read.
//
// `[]`, so a message can name a number even when the read failed.
//
// ```novo
// use wtinotify
//
// fn main() [io]
//     println("${wtinotify.default_limits().max_user_watches}")
// ```
pub fn default_limits() -> WtInotifyLimits []
    WtInotifyLimits { max_user_watches: 8192, max_user_instances: 128,
                      max_queued_events: 16384 }

// Would this many watches fit under this limit?
//
// `[]`, published because the check belongs BEFORE the walk: a tool
// that counted the directories it was about to watch and compared them
// here can tell a person what to do, where one that walked until the
// kernel refused has already placed eight thousand watches it now has to
// unwind.
//
// ```novo
// use wtinotify
//
// fn room(l: WtInotifyLimits, wanted: Int) -> Bool
//     wtinotify.fits(l, wanted)
//
// fn main() [io]
//     println("whether a tree will fit under the limit")
// ```
pub fn fits(l: WtInotifyLimits, wanted: Int) -> Bool []
    wanted <= l.max_user_watches

// The `sysctl` line that would raise the watch limit to this number.
//
// `[]`, and it exists because the line is the whole of what a person
// needs and nobody remembers it: a tool that prints
// `fs.inotify.max_user_watches=524288` beside its refusal has solved the
// problem, and one that prints "too many watches" has moved it.
//
// ```novo
// use wtinotify
//
// fn main() [io]
//     println(wtinotify.raise_limit_hint(524288))
// ```
pub fn raise_limit_hint(wanted: Int) -> Str []
    "fs.inotify.max_user_watches=" + str.from_int(wanted)

// The read buffer size this backend was opened with.
//
// ```novo
// use wtinotify
//
// fn main() [io]
//     println("the buffer an inotify read uses")
// ```
pub fn buffer_size(w: WtInotify) -> Int []
    w.buffer_bytes

// How many watches this instance currently holds.
//
// ```novo
// use wtinotify
//
// fn held(w: WtInotify) -> Int
//     wtinotify.watches_held(w)
//
// fn main() [io]
//     println("how many watches an instance holds")
// ```
pub fn watches_held(w: WtInotify) -> Int []
    // An instance keeps no registry of its own — the watches are
    // recorded in the tree the caller holds — so the number the kernel
    // would give cannot be read from here.
    0

// What this backend cannot see, as a list a tool can print.
//
// Three entries, each a sentence: a network filesystem's changes, a bind
// mount's second path, and anything that happened between a directory
// being created and a watch reaching it.  Published as data rather than
// left in a README, because the question a person asks is "why did it
// not notice" and the answer should be in the tool they are already
// looking at.
//
// ```novo
// use wtinotify
//
// fn caveats() -> [Str]
//     wtinotify.known_blind_spots()
//
// fn main() [io]
//     println("what inotify does not see")
// ```
pub fn known_blind_spots() -> [Str] []
    ["A change made through a network filesystem is not reported, because the kernel is not told about it.",
      "A change made through a second path to the same file, such as a bind mount, is not reported on the path this watcher holds.",
      "A change that happens between a directory being created and a watch reaching it is lost, because the watch starts at that later instant."]
