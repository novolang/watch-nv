// wtpoll.nv — the backend that works everywhere, and what it costs.
//
// IT EXISTS BECAUSE inotify DOES NOT ALWAYS.  A network filesystem tells
// the kernel nothing, a FUSE mount may not signal, a container may not
// have the watches to spare, and every operating system that is not
// Linux has a different mechanism.  A `--watch` mode that only worked
// under inotify would be a `--watch` mode that silently did nothing on
// exactly the setups where people most want it.
//
// A SNAPSHOT IS A VALUE AND COMPARING TWO IS `[]`.  `scan` reads the
// tree, which is `[fs]`; `diff_snapshots` compares two, which is nothing
// at all.  That is the split that makes this testable: a test builds two
// snapshots from literals and asserts on the events, with no directory
// anywhere, and every case that matters — a file whose size changed, one
// whose mtime went BACKWARDS, one replaced within a second — is a
// microsecond.
//
// THE COMPARISON IS `(size, mtime, mode)` AND NOT A HASH, for the same
// reason git's index compares `stat` data: hashing a tree per interval
// would read every byte of a repository every second.  The cost is a
// change that keeps all three the same and is therefore invisible — a
// file rewritten within the mtime's resolution with identical length —
// and `rehash_suspicious` is the escape for a caller that cannot accept
// that.
//
// AN mtime THAT WENT BACKWARDS IS A CHANGE.  A checkout, a restore from
// a backup and an `rsync --times` all write files whose mtime is OLDER
// than what was there, and a comparison written as `new > old` reports
// nothing happened.  It is `!=`, and the case is asserted rather than
// argued.
//
// THE INTERVAL IS THE CALLER'S and there is no thread here.  `scan`
// answers when it has read the tree; `wtloop` decides when to call it
// again.  A backend that slept inside itself would own the caller's
// scheduling and could not be tested without waiting.

use wtfilter
use wtwatch
use wtevent

// One path as a scan saw it.
//
// Three numbers and a flag, which is what a `stat` gives cheaply and
// what a change reliably moves at least one of.
pub struct WtStatEntry
    path: Str
    is_directory: Bool
    size: Int
    mtime_seconds: Int
    mtime_nanos: Int
    mode: Int

// A whole tree as a scan saw it.
//
// Entries in path order, so comparing two is a merge rather than a
// lookup per path — which on a tree of a hundred thousand files is the
// difference between a comparison that finishes inside the poll interval
// and one that does not.
pub struct WtSnapshot
    root: Str
    entries: [WtStatEntry]
    // When the scan ran, as the caller's clock reading, so the events a
    // comparison produces can be stamped without reading it again.
    at_unix: Float
    // The scan stopped at `max_entries` and the snapshot is partial.  A
    // comparison against a partial snapshot would report the unscanned
    // remainder as deleted, so this is checked rather than assumed.
    truncated: Bool

// A polling backend over one root.
pub struct WtPoller
    root: Str
    filter: WtFilter
    max_depth: Int
    max_entries: Int
    // A cell the caller owns, which this backend neither reads nor
    // writes: a poller holds nothing between calls, so every `poll`
    // compares the tree against an empty snapshot.
    slot: Int

// What one entry costs a scan, in seconds: a directory read and a
// `stat` for each name in it.
//
// Two microseconds is a warm page cache on a laptop and far from what a
// cold tree or a network mount gives, which is why the figures below are
// published as rough rather than promised.
let per_entry_seconds = 0.000002

// How many entries fit inside this deadline.
//
// The deadline can only be honoured as work: nothing in this module's
// rows reads a clock, so the estimate is inverted into an entry budget
// and the scan stops there.  One entry is always read, so a caller that
// passes a zero deadline still makes progress rather than livelocking.
fn entries_within(seconds: Float) -> Int
    let n = float.to_int((seconds - 0.0001) / per_entry_seconds)
    if n < 1
        1
    else
        n

// A child's path, keeping the root's own spelling.
//
// A root of `.` answers `src/main.nv` and an absolute one answers
// absolute paths, which is what the `stat` calls below need while the
// filter keeps the relative form.
fn join_path(dir: Str, name: Str) -> Str
    if dir == "" or dir == "."
        name
    else
        dir + "/" + name

// The numbers a scan can read for one path.
//
// A path that vanished between being listed and being read answers
// zeroes, which the next comparison reports as a removal: that is the
// truth, where failing a whole scan over one racing file would not be.
fn stat_entry(path: Str, is_directory: Bool) -> WtStatEntry [fs]
    let size = fs.size(path) ?? 0
    let mtime = fs.file_mtime(path) ?? 0
    let mode = fs.file_mode(path) ?? 0
    WtStatEntry { path: path, is_directory: is_directory, size: size, mtime_seconds: mtime,
                  mtime_nanos: 0, mode: mode }

// Appends every admitted entry below `dir`, answering whether the scan
// stopped before the tree did.
//
// The cap is checked while reading rather than after, so a tree far past
// `max_entries` costs only what the cap allows, and the depth check is
// what stops a symlink loop from being a hang.
fn walk(p: WtPoller, dir: Str, depth: Int, var entries: [WtStatEntry]) -> Bool [fs]
    if depth > p.max_depth
        return true
    let f = p.filter
    for name in fs.read_dir(dir)
        if list.len(entries) >= p.max_entries
            return true
        if name == "." or name == ".."
            // cov: skip — fs.read_dir names entries and never answers `.` or `..`, so this guard cannot fire here
            continue
        let child = join_path(dir, name)
        let is_directory = fs.is_dir(child)
        if is_directory and not wtfilter.may_descend(f, child)
            continue
        if wtfilter.admits(f, child, is_directory)
            entries = list.push(entries, stat_entry(child, is_directory))
        if is_directory
            if walk(p, child, depth + 1, entries)
                return true
    false

// Which kind of change these two entries are.
//
// A mode difference on its own is metadata, so a caller that filters
// metadata events gets what it asked for; a size or an mtime that moved
// is a modification whatever else moved with it.
fn changed_kind(a: WtStatEntry, b: WtStatEntry) -> WtEventKind
    let mode_only = a.mode != b.mode and a.size == b.size
    if mode_only and a.mtime_seconds == b.mtime_seconds and a.mtime_nanos == b.mtime_nanos
        WtMetadata
    else
        WtModified

// One entry as the event a comparison answers.
//
// The watch id is zero: a snapshot is the whole tree and names no watch,
// so a consumer can tell an event a scan produced from one a backend
// reported.
fn event_of(e: WtStatEntry, k: WtEventKind, at_unix: Float) -> WtEvent
    WtEvent { kind: k, path: e.path, is_directory: e.is_directory, at_unix: at_unix, watch_id: 0 }

// The raw kind a comparison event reports as.
//
// The inverse of the pairing module's plain kinds, so a poll's events
// go through the same rename pairing and filtering as a backend's.  A
// comparison never answers a rename — nothing in a `stat` connects two
// paths — so that arm only keeps the match total.
fn raw_kind(k: WtEventKind) -> WtRawKind
    match k
        WtCreated       => WtRawCreated
        WtMetadata      => WtRawMetadata
        WtRemoved       => WtRawRemoved
        WtMovedOut      => WtRawMovedFrom
        WtMovedIn       => WtRawMovedTo
        WtOverflow(_)   => WtRawOverflow
        WtWatchLost(_)  => WtRawWatchLost
        WtRenamed(_, _) => WtRawModified
        WtModified      => WtRawModified

// One comparison event in the shape a backend reports its events in.
fn raw_of(e: WtEvent) -> WtRawEvent
    WtRawEvent { kind: raw_kind(e.kind), path: e.path, is_directory: e.is_directory, cookie: 0,
                 watch_id: 0 }

// Reading directories costs `[fs]`, which is what the impl head
// declares — and it is the honest difference from the inotify backend
// beside it, which is `[io]` because a watch is a descriptor.
impl WatchBackend[fs] for WtPoller
    // Accept the watch.  A polling backend has one root and no per
    // directory state.
    fn watch(self, path: Str) -> Result<Int, WtFault> [fs]
        if not fs.exists(path)
            return Err(WtNotFound(path))
        // Nothing is placed: a scan reads the whole tree from the root,
        // so there is no per-directory watch to name.  Zero is that
        // nothing, and `watch_tree` records no watch for it.
        Ok(0)

    // Forget a path.
    fn unwatch(self, id: Int) -> Result<Unit, WtFault> [fs]
        // Nothing was placed for any id, and removing a watch that was
        // never there is not a failure.
        Ok(())

    // Scan, and answer the differences.
    //
    // The deadline bounds the SCAN rather than a wait: a tree too large
    // to read inside it answers what it read with `timed_out` false, so
    // a caller that is being starved can see it.
    fn poll(self, timeout_seconds: Float) -> Result<WtPoll, WtFault> [fs]
        let cap = if entries_within(timeout_seconds) < self.max_entries
            entries_within(timeout_seconds)
        else
            self.max_entries
        let narrowed = bounded(self, self.max_depth, cap)
        let scanned = scan(narrowed, 0.0)!
        // A poller holds no snapshot between calls — `slot` names a cell
        // only the caller can reach — so what it compares against is the
        // snapshot a poller starts from, and every admitted path is
        // reported as a creation.
        let changes = diff_snapshots(empty_snapshot(self.root, 0.0), scanned)
        var raw: [WtRawEvent] = []
        list.append(raw, list.map(changes, e => raw_of(e)))
        Ok(WtPoll { events: raw, timed_out: not scanned.truncated, overflowed: false })

    // Drop the snapshot.
    fn close(self) -> Result<Unit, WtFault> [fs]
        // A poller keeps no snapshot between calls, so there is nothing
        // to release here and nothing the caller must free.
        Ok(())

// A poller over this root, with this filter.
//
// ```novo
// use wtfilter
// use wtpoll
//
// fn main() [io]
//     let p = wtpoll.poller(".", wtfilter.everything(), 0)
//     println(p.root)
// ```
pub fn poller(root: Str, f: WtFilter, slot: Int) -> WtPoller []
    // Sixty-four levels is past every repository a person watches and
    // short of a symlink loop's patience; two hundred thousand entries
    // is the largest tree a scan still finishes inside a second.
    WtPoller { root: root, filter: f, max_depth: 64, max_entries: 200000, slot: slot }

// The same poller with a depth and an entry bound.
//
// Both exist because a poller with neither is a program that walks into
// a symlink loop or reads a two-million-file tree every interval.
//
// ```novo
// use wtfilter
// use wtpoll
//
// fn main() [io]
//     let p = wtpoll.bounded(wtpoll.poller(".", wtfilter.everything(), 0), 64, 200000)
//     println("${p.max_depth}")
// ```
pub fn bounded(p: WtPoller, max_depth: Int, max_entries: Int) -> WtPoller []
    WtPoller { root: p.root, filter: p.filter, max_depth: max_depth, max_entries: max_entries,
               slot: p.slot }

// Read the tree.
//
// `[fs]`, and `now_unix` is the caller's clock reading — so the scan
// itself reads no clock and a test supplies one.
//
// Descends only where `wtfilter.may_descend` says to, which is the same
// decision the inotify backend makes and for a sharper reason here: an
// unfiltered scan of a repository with a build directory reads two
// hundred thousand entries every interval.
//
// ```novo
// use wtpoll
//
// fn look(p: WtPoller) -> Result<WtSnapshot, WtFault> [fs]
//     wtpoll.scan(p, 1757548800.0)
//
// fn main() [io]
//     println("a tree, as it is now")
// ```
pub fn scan(p: WtPoller, now_unix: Float) -> Result<WtSnapshot, WtFault> [fs]
    if not fs.exists(p.root)
        return Err(WtNotFound(p.root))
    if not fs.is_dir(p.root)
        return Err(WtBackendFailed("the watch root is not a directory"))
    var entries: [WtStatEntry] = []
    let truncated = walk(p, p.root, 0, entries)
    // Path order is load-bearing for the comparison, and a directory
    // read answers in whatever order the filesystem keeps.
    entries = list.sort_by(entries, e => e.path)
    Ok(WtSnapshot { root: p.root, entries: entries, at_unix: now_unix, truncated: truncated })

// The events between two snapshots.
//
// `[]`, and it is the function this module's test suite spends its cases
// on.  Both snapshots are in path order, so it is one merge.
//
// A path in the second and not the first is a create; in the first and
// not the second, a remove; in both with any of size, mtime or mode
// different, a modify — where a mode-only difference is `WtMetadata`, so
// a caller filtering those gets what it asked for.
//
// A rename is NOT detected: polling cannot tell one from a delete and a
// create, because nothing in a `stat` connects the two paths.  Said
// here rather than approximated, because a heuristic that paired a
// delete and a create by size would pair two unrelated empty files.
//
// ```novo
// use wtpoll
//
// fn changed(a: WtSnapshot, b: WtSnapshot) -> [WtEvent]
//     wtpoll.diff_snapshots(a, b)
//
// fn main() [io]
//     println("what changed between two scans")
// ```
pub fn diff_snapshots(before: WtSnapshot, after: WtSnapshot) -> [WtEvent] []
    // A partial snapshot on the BEFORE side would report the unscanned
    // remainder as deleted; a partial one on the after side only misses
    // creations, which the next scan reports.
    if before.truncated
        return []
    let xs = before.entries
    let ys = after.entries
    var out: [WtEvent] = []
    var i = 0
    var j = 0
    while i < list.len(xs) and j < list.len(ys)
        let a = xs[i]
        let b = ys[j]
        if a.path == b.path
            if entry_changed(a, b)
                out = list.push(out, event_of(b, changed_kind(a, b), after.at_unix))
            i = i + 1
            j = j + 1
        else if a.path < b.path
            out = list.push(out, event_of(a, WtRemoved, after.at_unix))
            i = i + 1
        else
            out = list.push(out, event_of(b, WtCreated, after.at_unix))
            j = j + 1
    list.append(out, list.map(xs[i:], x => event_of(x, WtRemoved, after.at_unix)))
    list.append(out, list.map(ys[j:], y => event_of(y, WtCreated, after.at_unix)))
    out

// An empty snapshot of this root.
//
// What a poller starts from, so the first scan reports everything as
// created — which is correct and is what a `--watch` mode wants, because
// it builds once at startup anyway.
//
// ```novo
// use wtpoll
//
// fn main() [io]
//     println("${list.len(wtpoll.empty_snapshot(".", 0.0).entries)}")
// ```
pub fn empty_snapshot(root: Str, at_unix: Float) -> WtSnapshot []
    WtSnapshot { root: root, entries: [], at_unix: at_unix, truncated: false }

// One entry, from the numbers a `stat` gave.
//
// Taking them rather than reading them, which is what keeps
// `diff_snapshots` testable from literals.
//
// ```novo
// use wtpoll
//
// fn main() [io]
//     println(wtpoll.entry("src/main.nv", false, 42, 1757548800, 0, 33188).path)
// ```
pub fn entry(path: Str, is_directory: Bool, size: Int, mtime_seconds: Int, mtime_nanos: Int,
             mode: Int) -> WtStatEntry []
    WtStatEntry { path: path, is_directory: is_directory, size: size,
                  mtime_seconds: mtime_seconds, mtime_nanos: mtime_nanos, mode: mode }

// A snapshot from entries the caller has.
//
// Sorted here, so a caller building one from a walk of its own does not
// have to know that the order is load-bearing.
//
// ```novo
// use wtpoll
//
// fn main() [io]
//     println("${wtpoll.snapshot(".", [], 0.0).truncated}")
// ```
pub fn snapshot(root: Str, entries: [WtStatEntry], at_unix: Float) -> WtSnapshot []
    let ordered = list.sort_by(list.clone(entries), e => e.path)
    WtSnapshot { root: root, entries: ordered, at_unix: at_unix, truncated: false }

// Did these two entries change?
//
// Size, mtime or mode differing — with mtime compared for INEQUALITY
// rather than for being newer, because a checkout, a restore and an
// `rsync --times` all write files whose mtime goes backwards and a
// comparison written as `new > old` reports that nothing happened.
//
// ```novo
// use wtpoll
//
// fn moved(a: WtStatEntry, b: WtStatEntry) -> Bool
//     wtpoll.entry_changed(a, b)
//
// fn main() [io]
//     println("whether one path changed between scans")
// ```
pub fn entry_changed(before: WtStatEntry, after: WtStatEntry) -> Bool []
    if before.size != after.size
        return true
    if before.mtime_seconds != after.mtime_seconds or before.mtime_nanos != after.mtime_nanos
        return true
    before.mode != after.mode

// The paths a `stat` comparison cannot be sure about.
//
// An entry whose mtime is within one second of the snapshot's own time
// and whose size did not change: a file rewritten inside the clock's
// resolution with the same length is invisible to this backend, which is
// the honest cost of not hashing.  A caller that cannot accept it reads
// and compares exactly these.
//
// The same shape as git's racy-clean rule, and for the same reason.
//
// ```novo
// use wtpoll
//
// fn unsure(a: WtSnapshot, b: WtSnapshot) -> [Str]
//     wtpoll.rehash_suspicious(a, b)
//
// fn main() [io]
//     println("the paths a stat comparison cannot settle")
// ```
pub fn rehash_suspicious(before: WtSnapshot, after: WtSnapshot) -> [Str] []
    let xs = before.entries
    let ys = after.entries
    var out: [Str] = []
    var i = 0
    var j = 0
    while i < list.len(xs) and j < list.len(ys)
        let a = xs[i]
        let b = ys[j]
        if a.path == b.path
            // Unchanged, and written inside the scan's own second: the
            // one case a `stat` cannot tell from an untouched file.
            let recent = after.at_unix - float_of_int(b.mtime_seconds) <= 1.0
            if not entry_changed(a, b) and recent
                out = list.push(out, b.path)
            i = i + 1
            j = j + 1
        else if a.path < b.path
            i = i + 1
        else
            j = j + 1
    out

// How long the last scan of this many entries is likely to take, in
// seconds.
//
// A rough figure from the entry count, published so a tool can refuse to
// poll at 100 ms a tree that takes 400 ms to read — which is a program
// that spends every cycle scanning and never reports anything, and which
// looks from outside exactly like a program that is broken.
//
// ```novo
// use wtpoll
//
// fn cost(entries: Int) -> Float
//     wtpoll.estimated_scan_seconds(entries)
//
// fn main() [io]
//     println("roughly how long a scan takes")
// ```
pub fn estimated_scan_seconds(entries: Int) -> Float []
    float_of_int(entries) * per_entry_seconds + 0.0001

// The smallest interval this tree can sensibly be polled at.
//
// `estimated_scan_seconds` with headroom.  A tool prints it when a
// caller asks for something faster, rather than accepting the number and
// silently never keeping up.
//
// ```novo
// use wtpoll
//
// fn floor(entries: Int) -> Float
//     wtpoll.minimum_interval(entries)
//
// fn main() [io]
//     println("the fastest this tree can be polled")
// ```
pub fn minimum_interval(entries: Int) -> Float []
    estimated_scan_seconds(entries) * 4.0
